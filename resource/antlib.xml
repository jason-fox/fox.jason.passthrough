<antlib xmlns:if="ant:if" xmlns:unless="ant:unless">

  <!--
    Bridges an Ant property to a JVM system property

    @param  name -   The system property key to set
    @param  value -  The value to set it to
  -->
  <taskdef
    classname="fox.jason.passthrough.tasks.PublishSystemPropertyTask"
    name="publish-system-property"
    onerror="ignore"
  />

</antlib>

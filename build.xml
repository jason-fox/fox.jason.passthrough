<project name="fox.jason.passthrough">

	<target name="passthrough.init" xmlns:if="ant:if">
		<typedef file="${dita.plugin.fox.jason.passthrough.dir}/resource/antlib.xml"/>
		<publish-system-property name="default.language" value="${default.language}"/>
		<publish-system-property name="dita.temp.dir" value="${dita.temp.dir}"/>
		<dirname property="passthrough.input.dir" file="${args.input}"/>
		<publish-system-property name="passthrough.input.dir" value="${passthrough.input.dir}"/>
		<publish-system-property if:set="passthrough.spec.keep" name="passthrough.spec.keep" value="${passthrough.spec.keep}"/>
	</target>

	<!--
		Ant target executed to convert passthrough files to DITA
	-->
	<target
    name="dita2passthrough-convert"
    depends="build-init,
                   preprocess"
  >
    <makeurl property="output.dir.uri" file="${output.dir}"/>
    <!--pipeline message="Normalize DITA files" taskname="normalize"-->
      <xslt
      in="${dita.temp.dir}/.job.xml"
      out="${dita.temp.dir}/.job.xml.temp"
      style="${dita.plugin.fox.jason.passthrough.dir}/xsl/passthrough.xsl"
      taskname="normalize"
    >
        <param name="output.dir.uri" expression="${output.dir.uri}"/>
        <xmlcatalog refid="dita.catalog"/>
      </xslt>
    <!--/pipeline-->
    <delete file="${dita.temp.dir}/.job.xml.temp"/>
	</target>

</project>
